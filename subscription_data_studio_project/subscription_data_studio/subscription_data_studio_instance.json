    "definitionText": "dimension: subscription_start_dt {\n  label: \"dates\"\n  type: date\n  sql: date(${subscription_records.subscription_start_ts}) ;;\n}\n\ndimension: state {\n  label: \"geography\"\n  type: string\n  sql: ${user_records.state} ;;\n}\n\ndimension: city {\n  label: \"geography\"\n  type: string\n  sql: ${user_records.city} ;;\n}\n\ndimension: dob {\n  label: \"demographic\"\n  type: string\n  sql: ${user_records.dob} ;;\n}\n\ndimension: subscription_type {\n  label: \"subscription\"\n  type: string\n  sql: ${subscription_records.subscription_type} ;;\n}\n\ndimension: subscription_status {\n  label: \"subscription\"\n  type: string\n  sql: ${subscription_records.subscription_status} ;;\n}\n\ndimension: cancel_status {\n  label: \"subscription\"\n  type: string\n  sql: ${subscription_records.cancel_status} ;;\n}\n\ndimension: payment_processor {\n  label: \"payment\"\n  type: string\n  sql: ${transaction_records.payment_processor} ;;\n}\n\ndimension: card_brand {\n  label: \"payment\"\n  type: string\n  sql: ${transaction_records.card_brand} ;;\n}\n\ndimension: subscription_length {\n  label: \"subscription\"\n  type: string\n  sql: ${subscription_records.subscription_length} ;;\n}\n\ndimension: payment_status {\n  label: \"scheduled\"\n  type: string\n  sql: ${scheduled_subscription_payment_records.payment_status} ;;\n}\n\ndimension: renewal_number {\n  label: \"scheduled\"\n  type: string\n  sql: ${scheduled_subscription_payment_records.renewal_number} ;;\n}\n\nmeasure: gross_revenue {\n  label: \"revenue\"\n  type: sum\n  sql: ${transaction_records.gross_amount} ;;\n  value_format: currency\n}\n\nmeasure: net_revenue {\n  label: \"revenue\"\n  type: sum\n  sql: ${transaction_records.net_amount} ;;\n  value_format: currency\n}\n\nmeasure: total_subscriptions {\n  label: \"subscription\"\n  type: sum\n  sql: case when ${subscription_records.subscription_type} in ('new_subscription','reactivation') then 1 else 0 end ;;\n  value_format: numeric\n}\n\nmeasure: new_subscriptions {\n  label: \"subscription\"\n  type: sum\n  sql: case when ${subscription_records.subscription_type}='new_subscription' then 1 else 0 end ;;\n  value_format: numeric\n}\n\nmeasure: reactivations {\n  label: \"subscription\"\n  type: sum\n  sql: case when ${subscription_records.subscription_type}='reactivation' then 1 else 0 end ;;\n  value_format: numeric\n}\n\nmeasure: active_subscriptions {\n  label: \"subscription\"\n  type: sum\n  sql: case when ${subscription_records.subscription_status}='active' then 1 else 0 end ;;\n  value_format: numeric\n}\n\nmeasure: cancelled_subscriptions {\n  label: \"subscription\"\n  type: sum\n  sql: case when ${subscription_records.subscription_status}='cancelled' then 1 else 0 end ;;\n  value_format: numeric\n}\n\nmeasure: pending_cancellation_subscriptions {\n  label: \"subscription\"\n  type: sum\n  sql: case when ${subscription_records.subscription_status}='pending_cancellation' then 1 else 0 end ;;\n  value_format: numeric\n}\n\nmeasure: percent_reactivations {\n  label: \"subscription\"\n  type: number\n  sql: {{reactivations}} / {{total_subscriptions}} ;;\n  value_format: percent\n}\n\nmeasure: percent_new_subscriptions {\n  label: \"subscription\"\n  type: number\n  sql: {{new_subscriptions}} / {{total_subscriptions}} ;;\n  value_format: percent\n}\n\nmeasure: percent_cancelled_subscriptions {\n  label: \"subscription\"\n  type: number\n  sql: {{cancelled_subscriptions}} / {{total_subscriptions}} ;;\n  value_format: percent\n}\n\nmeasure: percent_pending_cancellation_subscriptions {\n  label: \"subscription\"\n  type: number\n  sql: {{pending_cancellation_subscriptions}} / {{total_subscriptions}} ;;\n  value_format: percent\n}\n\nmeasure: percent_active_subscriptions {\n  label: \"subscription\"\n  type: number\n  sql: {{active_subscriptions}} / {{total_subscriptions}} ;;\n  value_format: percent\n}\n\nmeasure: discounts {\n  label: \"revenue\"\n  type: sum\n  sql: ${transaction_records.discount_amount} ;;\n  value_format: currency\n}\n\nmeasure: scheduled_gross_revenue {\n  label: \"scheduled\"\n  type: sum\n  sql: ${scheduled_subscription_payment_records.gross_amount} ;;\n  value_format: currency\n}\n\nmeasure: scheduled_discounts {\n  label: \"scheduled\"\n  type: sum\n  sql: ${scheduled_subscription_payment_records.discount_amount} ;;\n  value_format: currency\n}\n\nmeasure: scheduled_net_revenue {\n  label: \"scheduled\"\n  type: sum\n  sql: ${scheduled_subscription_payment_records.scheduled_amount} ;;\n  value_format: currency\n}\n\nmeasure: total_renewals {\n  label: \"scheduled\"\n  type: sum\n  sql: case when ${scheduled_subscription_payment_records.payment_status} in ('paid','scheduled') then 1 else 0 end ;;\n  value_format: numeric\n}\n\nmeasure: scheduled_taxes {\n  label: \"scheduled\"\n  type: sum\n  sql: ${scheduled_subscription_payment_records.tax_amount} ;;\n  value_format: currency\n}\n\nmeasure: paid_renewals {\n  label: \"scheduled\"\n  type: sum\n  sql: case when ${scheduled_subscription_payment_records.payment_status}='paid' then 1 else 0 end ;;\n  value_format: numeric\n}\n\nmeasure: scheduled_renewals {\n  label: \"scheduled\"\n  type: sum\n  sql: case when ${scheduled_subscription_payment_records.payment_status}='scheduled' then 1 else 0 end ;;\n  value_format: numeric\n}",
    "evaluationText": "measure: pending_cancellation_subscriptions {\n  label: \"subscription\"\n  type: sum\n  sql: case when ${subscription_records.subscription_status}='pending_cancellation' then 1 else 0 end ;;\n  value_format: numeric\n}",
    "evaluationSampleCount": "5"
  }
